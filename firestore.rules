rules_version = '2';
// HeroBet — Cloud Firestore security rules (demo-grade, client-settled)
//
// Deploy: firebase deploy --only firestore:rules
// (or paste into Firebase Console → Firestore Database → Rules)
//
// DEMO GRADE: the client currently settles bets and wallet credits itself,
// so a signed-in player can technically write their own wallet/bets.
// This is acceptable ONLY while all money is simulated. Before real money:
//   1. Deploy Cloud Functions for bet settlement + rain draws.
//   2. Change wallets/bets writes to `allow write: if false` (admin/functions only).
// See docs/SETUP-FIREBASE.md → "Production lockdown".

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // profiles
    match /users/{uid} {
      allow read: if signedIn();
      allow create, update: if isOwner(uid)
        && request.resource.data.uid == uid;
      allow delete: if false;
    }

    // wallets — balance only changes via transactions that append a ledger entry
    match /wallets/{uid} {
      allow read: if isOwner(uid);
      // DEMO GRADE (see header). Lock down to `if false` with Cloud Functions.
      allow create, update: if isOwner(uid);
      allow delete: if false;

      match /ledger/{entryId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid);
        allow update, delete: if false;
      }
    }

    // bets — public read (live feeds/tables), owner-writable while client-settled
    match /bets/{betId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'placed'
        && request.resource.data.payout == 0;
      // DEMO GRADE: client settlement. Lock down with Cloud Functions.
      allow update: if signedIn() && resource.data.uid == request.auth.uid;
      allow delete: if false;
    }

    // shared config (crash seed etc.) — read-only for clients
    match /config/{docId} {
      allow read: if true;
      allow write: if false; // manage via console / Cloud Functions
    }
  }
}
