rules_version = '2';

// HeroBet Markets — paper-trading desk.
//
// Threat model for THIS build: client-side settlement with simulated capital.
// Users may only ever touch their own account tree. Nothing here protects
// against a user editing their own paper balance — that's fine while the money
// is fake, and the lockdown steps below are what you flip before it isn't.
//
// PRODUCTION LOCKDOWN (see docs/SETUP-FIREBASE.md):
//   1. Move order matching + fills into Cloud Functions (Admin SDK).
//   2. Change the accounts/{uid} write rules to `if false`.
//   3. Enable App Check and require it here.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // ── profiles ───────────────────────────────────────────────
    // users/{uid}: private profile, owner only.
    match /users/{uid} {
      allow read, write: if isOwner(uid);
    }

    // profiles/{uid}: public leaderboard row. World-readable, owner-written,
    // and shape-checked so it can't be used as free storage.
    match /profiles/{uid} {
      allow read: if true;
      allow write: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['uid', 'name', 'equity', 'pnlPct', 'trades', 'updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 40
        && request.resource.data.equity is number
        && request.resource.data.pnlPct is number;
    }

    // ── trading account tree ───────────────────────────────────
    // Everything under accounts/{uid} is strictly private to that user.
    match /accounts/{uid} {
      allow read: if isOwner(uid);
      // PRODUCTION: change to `if false` once Cloud Functions settle trades.
      allow create, update: if isOwner(uid)
        && request.resource.data.cash is number
        && request.resource.data.cash >= 0;
      allow delete: if false;

      match /positions/{symbol} {
        allow read, write: if isOwner(uid);
      }

      match /orders/{orderId} {
        allow read, write: if isOwner(uid);
      }

      // Executions are immutable once written. Delete stays open only so the
      // owner can wipe the desk from Settings → Reset account.
      match /fills/{fillId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid);
        allow update: if false;
        allow delete: if isOwner(uid);
      }

      // The cash ledger is strictly append-only — it is never edited or
      // deleted, not even by a reset (which simply journals a new entry).
      match /ledger/{entryId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid);
        allow update, delete: if false;
      }

      match /watchlist/{symbol} {
        allow read, write: if isOwner(uid);
      }
    }

    // ── public trade tape ──────────────────────────────────────
    // Anyone can watch the desk; signed-in users append their own prints.
    match /tape/{id} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['name', 'symbol', 'assetClass', 'side', 'qty', 'price', 'createdAt'])
        && request.resource.data.symbol is string
        && request.resource.data.symbol.size() <= 16
        && request.resource.data.side in ['buy', 'sell']
        && request.resource.data.qty is number
        && request.resource.data.price is number;
      allow update, delete: if false;
    }

    // ── app config ─────────────────────────────────────────────
    // Read-only reachability probe + any future runtime flags.
    match /config/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // Default deny.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
