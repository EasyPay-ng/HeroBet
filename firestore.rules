rules_version = '2';

// HeroBet Markets — paper-trading desk.
//
// Threat model for THIS build: client-side settlement with simulated capital.
// Users may only ever touch their own account tree. Nothing here protects
// against a user editing their own paper balance — that's fine while the money
// is fake, and the lockdown steps below are what you flip before it isn't.
//
// PRODUCTION LOCKDOWN (see docs/SETUP-FIREBASE.md):
//   1. Move order matching + fills into Cloud Functions (Admin SDK).
//   2. Change the accounts/{uid} write rules to `if false`.
//   3. Enable App Check and require it here.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.email == 'beniwealth70@gmail.com';
    }

    // Client-written play-money demo only; values are NOT trustworthy for cash.
    match /demoPlayers/{uid} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['balance', 'bets', 'updatedAt'])
        && request.resource.data.balance is number
        && request.resource.data.balance >= 0
        && request.resource.data.balance <= 1000000000
        && request.resource.data.bets is list
        && request.resource.data.bets.size() <= 30
        && request.resource.data.updatedAt is number;
      allow delete: if false;
    }

    // ── NGN user wallets ───────────────────────────────────────
    // A signed-in user can read their wallet and bootstrap it ONCE with zero
    // NGN. After creation, browser clients cannot change the balance, currency,
    // timestamps, or transaction history. Only the designated admin can review
    // manual transfers and update wallets directly from the protected admin page.
    match /wallets/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['balance', 'currency', 'updatedAt'])
        && request.resource.data.balance is number
        && request.resource.data.balance == 0
        && request.resource.data.currency == 'NGN'
        && request.resource.data.updatedAt is number;
      allow update: if isAdmin()
        && request.resource.data.keys().hasOnly(['balance', 'currency', 'updatedAt'])
        && request.resource.data.balance is number
        && request.resource.data.balance >= 0
        && request.resource.data.currency == 'NGN'
        && request.resource.data.updatedAt is number;
      allow delete: if false;

      match /transactions/{transactionId} {
        allow read: if isOwner(uid) || isAdmin();
        allow create: if isAdmin()
          && request.resource.data.keys().hasOnly(['type', 'amount', 'balanceAfter', 'requestId', 'createdAt'])
          && request.resource.data.type in ['deposit', 'withdrawal']
          && request.resource.data.amount is number
          && request.resource.data.amount > 0
          && request.resource.data.balanceAfter is number
          && request.resource.data.balanceAfter >= 0
          && request.resource.data.requestId is string
          && request.resource.data.createdAt is number;
        allow update, delete: if false;
      }
    }

    // ── manual deposit / withdrawal requests ───────────────────
    // Users create their own pending requests. Only the admin can read every
    // request or change its review fields. Approvals in admin.js update the
    // request, wallet, and immutable wallet transaction in one transaction.
    match /depositRequests/{requestId} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'userEmail', 'amount', 'reference', 'senderName', 'status', 'createdAt'])
        && request.resource.data.userEmail is string
        && request.resource.data.userEmail == request.auth.token.email
        && request.resource.data.userEmail.size() <= 120
        && request.resource.data.amount is number
        && request.resource.data.amount >= 20
        && request.resource.data.amount <= 1000000000
        && request.resource.data.reference is string
        && request.resource.data.reference.size() >= 3
        && request.resource.data.reference.size() <= 80
        && request.resource.data.senderName is string
        && request.resource.data.senderName.size() <= 100
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt is number;
      allow update: if isAdmin()
        && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewedAt', 'reviewedBy'])
        && request.resource.data.status in ['approved', 'rejected']
        && request.resource.data.reviewedAt is number
        && request.resource.data.reviewedBy == 'beniwealth70@gmail.com';
      allow delete: if false;
    }

    match /withdrawalRequests/{requestId} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'userEmail', 'amount', 'bankName', 'accountName', 'accountNumber', 'status', 'createdAt'])
        && request.resource.data.userEmail is string
        && request.resource.data.userEmail == request.auth.token.email
        && request.resource.data.userEmail.size() <= 120
        && request.resource.data.amount is number
        && request.resource.data.amount >= 20
        && request.resource.data.amount <= 1000000000
        && request.resource.data.amount <= get(/databases/$(database)/documents/wallets/$(request.resource.data.uid)).data.balance
        && request.resource.data.bankName is string
        && request.resource.data.bankName.size() > 0
        && request.resource.data.bankName.size() <= 80
        && request.resource.data.accountName is string
        && request.resource.data.accountName.size() > 0
        && request.resource.data.accountName.size() <= 100
        && request.resource.data.accountNumber is string
        && request.resource.data.accountNumber.size() >= 6
        && request.resource.data.accountNumber.size() <= 20
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt is number;
      allow update: if isAdmin()
        && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewedAt', 'reviewedBy'])
        && request.resource.data.status in ['completed', 'rejected']
        && request.resource.data.reviewedAt is number
        && request.resource.data.reviewedBy == 'beniwealth70@gmail.com';
      allow delete: if false;
    }

    // ── profiles ───────────────────────────────────────────────
    // users/{uid}: private profile, owner only.
    match /users/{uid} {
      allow read, write: if isOwner(uid);
    }

    // profiles/{uid}: public leaderboard row. World-readable, owner-written,
    // and shape-checked so it can't be used as free storage.
    match /profiles/{uid} {
      allow read: if true;
      allow write: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['uid', 'name', 'equity', 'pnlPct', 'trades', 'updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 40
        && request.resource.data.equity is number
        && request.resource.data.pnlPct is number;
    }

    // ── trading account tree ───────────────────────────────────
    // Everything under accounts/{uid} is strictly private to that user.
    match /accounts/{uid} {
      allow read: if isOwner(uid);
      // PRODUCTION: change to `if false` once Cloud Functions settle trades.
      allow create, update: if isOwner(uid)
        && request.resource.data.cash is number
        && request.resource.data.cash >= 0;
      allow delete: if false;

      match /positions/{symbol} {
        allow read, write: if isOwner(uid);
      }

      match /orders/{orderId} {
        allow read, write: if isOwner(uid);
      }

      // Executions are immutable once written. Delete stays open only so the
      // owner can wipe the desk from Settings → Reset account.
      match /fills/{fillId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid);
        allow update: if false;
        allow delete: if isOwner(uid);
      }

      // The cash ledger is strictly append-only — it is never edited or
      // deleted, not even by a reset (which simply journals a new entry).
      match /ledger/{entryId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid);
        allow update, delete: if false;
      }

      match /watchlist/{symbol} {
        allow read, write: if isOwner(uid);
      }
    }

    // ── public trade tape ──────────────────────────────────────
    // Anyone can watch the desk; signed-in users append their own prints.
    match /tape/{id} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['name', 'symbol', 'assetClass', 'side', 'qty', 'price', 'createdAt'])
        && request.resource.data.symbol is string
        && request.resource.data.symbol.size() <= 16
        && request.resource.data.side in ['buy', 'sell']
        && request.resource.data.qty is number
        && request.resource.data.price is number;
      allow update, delete: if false;
    }

    // ── app config ─────────────────────────────────────────────
    // Read-only reachability probe + any future runtime flags.
    match /config/{docId} {
      allow read: if true;
      allow create, update: if isAdmin()
        && docId == 'depositAccount'
        && request.resource.data.keys().hasOnly(['bankName', 'accountName', 'accountNumber', 'updatedAt', 'updatedBy'])
        && request.resource.data.bankName is string
        && request.resource.data.bankName.size() > 0
        && request.resource.data.bankName.size() <= 80
        && request.resource.data.accountName is string
        && request.resource.data.accountName.size() > 0
        && request.resource.data.accountName.size() <= 100
        && request.resource.data.accountNumber is string
        && request.resource.data.accountNumber.size() >= 6
        && request.resource.data.accountNumber.size() <= 20
        && request.resource.data.updatedAt is number
        && request.resource.data.updatedBy == 'beniwealth70@gmail.com';
      allow delete: if false;
    }

    // Default deny.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
